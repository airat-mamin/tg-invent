# Токен Telegram-бота от @BotFather. Обязательная переменная.
BOT_TOKEN=123456:ABC-DEF...

# Список Telegram ID через запятую. Пустое значение = доступ открыт всем (только для отладки).
ALLOWED_USER_IDS=
# Администраторы: доступ к /stats и выгрузке всех записей.
ADMIN_USER_IDS=

# Контур №1 (EasyOCR). Требует установки requirements-ocr.txt.
OCR_ENABLED=true
OCR_LANGS=en
# Дочитывать производителя и модель через OCR после успешного штрихкода.
# Даёт более полную карточку, но увеличивает ответ примерно с 0.4 с до 3 с.
OCR_ENRICH_AFTER_BARCODE=false

# Контур №2 (Llama 3.2 Vision через Ollama). Требует GPU >= 10 ГБ VRAM.
VLM_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:11b
OLLAMA_TIMEOUT=60
MAX_CONCURRENT_VLM=1

# Каталог с шаблонами разбора шильдиков, см. templates/README.md
TEMPLATES_DIR=templates

DB_PATH=data/bot.db
STORE_IMAGES=false
IMAGE_DIR=data/images
IMAGE_RETENTION_DAYS=30

RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
LOG_JSON=false
